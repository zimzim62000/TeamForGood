# 32 octets aléatoires, encodés en 64 caractères hexadécimaux.
SESSION_SECRET_HEX=

# Jeton long et aléatoire utilisé uniquement pour /admin et /api/admin/*.
ADMIN_API_TOKEN=

# Exemple : {"primetime":{"secretsHex":["secret-actuel","ancien-secret-pendant-la-rotation"]}}
RETRO_TENANTS_JSON=

# Origines autorisées à intégrer l'application dans une iframe, séparées par des espaces.
FRAME_ANCESTORS=https://intranet.example.com
PUBLIC_BASE_URL=https://retrogaming.tousamba.cloud

# Seulement pour un environnement local sans iframe Primetime.
ALLOW_DEV_IDENTITY=false
INTRANET_TENANT_ID=primetime
